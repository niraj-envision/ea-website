# Resend (https://resend.com) — used by contact form + HamroSkill waitlist
# 1. Sign up at https://resend.com (free tier: 3,000 emails/month, 100/day)
# 2. Create an API key, paste it below
# 3. To send from your own domain (info@envisionanalytics.net), verify the domain in Resend.
#    Until then, leave CONTACT_FROM_EMAIL unset — it defaults to onboarding@resend.dev (Resend's shared sender).
RESEND_API_KEY=

# Where contact-form and waitlist emails get delivered. Defaults to info@envisionanalytics.net.
CONTACT_TO_EMAIL=info@envisionanalytics.net

# Sender shown on outbound emails. Once envisionanalytics.net is verified in Resend,
# set this to something like: "Envision Analytics <hello@envisionanalytics.net>"
# CONTACT_FROM_EMAIL=
